/* 全局样式 */
page {
  height: 100%;
  background: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #2c2c2a;
  -webkit-font-smoothing: antialiased;
}

/* 通用按钮重置 */
button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: none;
}
