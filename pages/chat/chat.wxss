/* 聊天页面样式 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f7;
}

/* ===== 顶部导航 ===== */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ececec;
  flex: none;
}
.nav-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn:active {
  background: #f1f1f1;
}
.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2c2c2a;
  max-width: 400rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.menu-icon {
  width: 40rpx;
  height: 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.menu-icon .bar {
  height: 4rpx;
  background: #2c2c2a;
  border-radius: 4rpx;
}
.new-icon {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #2c2c2a;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 40rpx;
  color: #2c2c2a;
}

/* ===== 聊天区 ===== */
.chat {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}
.msg {
  max-width: 78%;
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}
.msg.user {
  margin-left: auto;
  background: #378add;
  color: #ffffff;
  border-top-right-radius: 8rpx;
}
.msg.assistant {
  background: #ffffff;
  color: #2c2c2a;
  border: 1rpx solid #ececec;
  border-top-left-radius: 8rpx;
}
.msg-img {
  margin-left: auto;
  max-width: 60%;
  border-radius: 24rpx;
  border-top-right-radius: 8rpx;
}

/* 正在输入动画 */
.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.t-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b4b2a9;
  animation: blink 1s infinite;
}
.t-dot:nth-child(2) {
  animation-delay: 0.2s;
}
.t-dot:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* ===== 侧边栏 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s;
  z-index: 90;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 520rpx;
  background: #ffffff;
  z-index: 100;
  transform: translateX(-100%);
  transition: transform 0.25s;
  display: flex;
  flex-direction: column;
}
.sidebar.open {
  transform: translateX(0);
}
.sidebar-head {
  padding: 32rpx 36rpx 24rpx;
  font-size: 26rpx;
  color: #888780;
}
.proj-list {
  flex: 1;
  padding: 0 20rpx;
}
.proj {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
}
.proj:active {
  background: #f5f6f7;
}
.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  flex: none;
}
.proj-name {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.proj-time {
  font-size: 24rpx;
  color: #b4b2a9;
}

/* ===== 上传面板 ===== */
.upload-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s;
  z-index: 110;
}
.upload-mask.show {
  opacity: 1;
  visibility: visible;
}
.upload-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 120;
  transform: translateY(100%);
  transition: transform 0.25s;
}
.upload-panel.show {
  transform: translateY(0);
}
.up-grid {
  display: flex;
  justify-content: space-around;
}
.up-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}
.up-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  color: #ffffff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.up-label {
  font-size: 26rpx;
  color: #2c2c2a;
}
.up-cancel {
  margin-top: 40rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #888780;
  background: #f5f6f7;
  border-radius: 20rpx;
}

/* ===== 底部输入栏 ===== */
.inputbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #ececec;
  flex: none;
}
.plus-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid #d3d1c7;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex: none;
}
.plus-btn:active {
  background: #f1f1f1;
}
.plus-symbol {
  font-size: 48rpx;
  line-height: 48rpx;
  color: #2c2c2a;
  margin-top: -4rpx;
}
.inputwrap {
  flex: 1;
  background: #f1f1f1;
  border-radius: 38rpx;
  padding: 0 30rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
}
.input {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2a;
}
.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #d3d1c7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: background 0.2s;
}
.send-btn.active {
  background: #378add;
}
.send-symbol {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #ffffff;
  margin-top: -4rpx;
}
